# 复制成 docker-compose.yml 后按需修改（docker-compose.yml 已 gitignore，不会入库）：
#
#   cp docker-compose.yml.example docker-compose.yml
#   docker compose up -d --build
#
# 端口、数据路径等本机相关的配置都改在 docker-compose.yml 里，
# 这样 git pull 不会和你的本地改动冲突。
services:
  stock:
    build: .
    container_name: personal-stock
    restart: unless-stopped
    ports:
      - "8000:8000"
    volumes:
      # SQLite 数据持久化：改为你 NAS 上的实际路径
      - ./data:/data
    # 环境变量可按需覆盖
    environment:
      - STOCK_DB_PATH=/data/stock.db
